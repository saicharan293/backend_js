<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full main min-h-screen bg-zinc-900">
        <div class="form p-10 text-white">
            <form action="">
                <input class="block w-full rounded-md outline-none px-5 py-2 bg-zinc-800" type="text" placeholder="Title goes here">
                <textarea class="block w-full rounded-md outline-none mt-2 px-5 py-2 bg-zinc-800 resize-none" placeholder="Write your task details here"></textarea>
                <input type="submit" class="mt-2 bg-blue-600 px-5 py-2 rounded-md" value="Create Task">
            </form>
        </div>
        <div class="tasks p-10">
            <div class="task w-72 px-3 py-4 bg-zinc-800 rounded-md"></div>
        </div>
    </div>
</body>
</html>