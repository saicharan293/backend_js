<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full main min-h-screen bg-zinc-900">
        <div class="form p-10 text-white">
            <form action="/create" method="post">
                <input name="title" class="block w-full rounded-md outline-none px-5 py-2 bg-zinc-800" type="text" placeholder="Title goes here">
                <textarea name="details" class="block w-full rounded-md outline-none mt-2 px-5 py-2 bg-zinc-800 resize-none" placeholder="Write your task details here"></textarea>
                <input type="submit" class="mt-2 bg-blue-600 px-5 py-2 rounded-md" value="Create Task">
            </form>
        </div>
        <div class="tasks flex gap-4 flex-wrap p-10">
            <% if(files.length>0){ %>
                <% files.forEach(function(val){ %>
                    <div class="task min-w-72 px-3 py-4 bg-zinc-800 rounded-md">
                        <h1 class="text-white text-2xl tracking-tighter"><%= val %></h1>
                        <div class="flex mt-3 items-center justify-between">

                            <a class="text-zinc-500" href="/edit/<%= val %>">Edit</a>
                            <a href="/file/<%= val %>" target="_blank" class="text-blue-500 inline-block ">Read More.</a>
                        </div>
                    </div>
                <% }) %>
            <% } else {  %>
                <h3 class="text-zinc-600">No task yet.</h3>
            <% }  %>
            
        </div>
    </div>
</body>
</html>