<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 text-white p-5">
        <div class="nav mb-10">
            <a class="text-blue-500" href="/read">Read Users</a>
        </div>
        <h1 class="text-3xl tracking-tigher mb-3">Update User</h1>
        <form action="/update/<%= user._id %>" method="post">
            <input type="text" class="px-5 border-2 border-zinc-600 outline-none rounded-lg py-2 bg-transparent" placeholder="name..." name="fullname" value="<%= user.username %>">
            <input type="text" class="px-5 border-2 border-zinc-600 outline-none rounded-lg py-2 bg-transparent" placeholder="email..." name="email" value="<%= user.email %>">
            <input type="text" class="px-5 border-2 border-zinc-600 outline-none rounded-lg py-2 bg-transparent" placeholder="url..." name="imageurl" value="<%= user.imageurl %>">
            <input type="submit" value="Update User" class="px-5 py-2 bg-yellow-600 rounded-lg outline-none ml-3 text-black">
        </form>
    </div>
</body>
</html>