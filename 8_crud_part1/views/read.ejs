<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 text-white p-5">
        <div class="nav mb-10">
            <a class="text-blue-500" href="/">Back To Home</a>
        </div>
        <h1 class="text-3xl tracking-tigher mb-3">All Users</h1>
        <div class="users flex gap-3 flex-wrap">
            <% if(users.length>0){%>
            <% users.forEach(function(val){ %>
            <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                    <div class="w-full h-72 rounded-lg bg-zinc-300 overflow-hidden">
                        <img class="w-full h-full object-cover object-center" src="<%= val.imageurl %>" alt="">
                    </div>
                    <h3 class="text-xl tracking-tigher mt-3"><%= val.username %></h3>
                    <h5 class="text-zinc-500 "><%= val.email %></h5>
                    <div class="flex gap-3">
                        <a href="/edit/<%= val._id %>" class="text-zinc-200">Edit User</a>
                        <a href="/delete/<%= val._id %>" class="text-red-500">Delete User</a>
                    </div>
                </div>
            <% }) %>
            <%} else {%>
                <h3 class="text-zinc-400">No users yet</h3>
            <% } %>
        </div>
    </div>
</body>
</html>